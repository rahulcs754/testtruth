{
  "name": "testtruth",
  "version": "0.1.0",
  "description": "Mutation-test only the lines your PR changed, and see which changes no test would catch.",
  "type": "module",
  "license": "MIT",
  "bin": { "testtruth": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
